<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model id="H2_O2_to_H2O">
    <listOfCompartments>
      <compartment id="cell" spatialDimensions="3" size="1" constant="true"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="H2" compartment="cell" initialAmount="20000" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="O2" compartment="cell" initialAmount="10000" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="H2O" compartment="cell" initialAmount="0" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfReactions>
      <reaction id="H2_plus_O2_to_H2O" reversible="false">
        <listOfReactants>
          <speciesReference species="H2" stoichiometry="2" constant="true"/>
          <speciesReference species="O2" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="H2O" stoichiometry="2" constant="true"/>
        </listOfProducts>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
